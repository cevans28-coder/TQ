}

// --- CSV PARSING ENGINE ---

function robustCsvParse(csvText) {
  if(!csvText) return [];
  let cleanText = csvText.replace(/\t/g, ',');
  cleanText = cleanText.replace(/[\u200B-\u200D\uFEFF]/g, '');
  try {
    return Utilities.parseCsv(cleanText);
  } catch (err) {
    let lines = cleanText.split(/\r?\n/);
    let result = [];
    for (let i = 0; i < lines.length; i++) {
      let line = lines[i].trim().replace(/"/g, ""); 
      let parts = line.split(',');
      if (parts.length <= 10) result.push(parts);
      else {
        let reconstructed = [];
        let len = parts.length;
        reconstructed[0] = parts[0]; reconstructed[1] = parts[1]; reconstructed[2] = parts[2];
        reconstructed[9] = parts[len - 1]; reconstructed[8] = parts[len - 2]; reconstructed[7] = parts[len - 3];
        reconstructed[6] = parts[len - 4]; reconstructed[5] = parts[len - 5]; reconstructed[4] = parts[len - 6];
        let refParts = [];
        for (let k = 3; k <= len - 7; k++) refParts.push(parts[k]);
        reconstructed[3] = refParts.join(', ');
        result.push(reconstructed);
      }
    }
    return result;
  }
}

function processStatementCsv(csvText) {
  try {
    const data = robustCsvParse(csvText);
    if (data.length < 2) return { success: false, error: "Invalid CSV or empty statement." };
    
    // Map headers exactly to your new spec
    const headers = data[0].map(h => (h || "").trim().toLowerCase());
    
    const timeIdx = headers.indexOf('time');
    const sourceIdx = headers.indexOf('source');
    const subTypeIdx = headers.indexOf('source sub-type');
    const refIdx = headers.indexOf('reference');
    const cpIdx = headers.indexOf('counterparty');
    const statusIdx = headers.indexOf('status');
    const amtIdx = headers.indexOf('amount'); // We use the final Amount column

    if (timeIdx === -1 || amtIdx === -1) {
      return { success: false, error: "Could not detect 'Time' or 'Amount' columns. Ensure you copied the exact CSV headers." };
    }

    let transactions = [];
    
    for (let i = 1; i < data.length; i++) {
      if (data[i].length < headers.length) continue; 
      
      let rawAmt = parseFloat(data[i][amtIdx]);
      if (isNaN(rawAmt)) continue;
      
      // We only want Outbound payments (Debits), which are negative
      if (rawAmt >= 0) continue; 
      
      let source = sourceIdx !== -1 ? data[i][sourceIdx] : "";
      let subType = subTypeIdx !== -1 ? data[i][subTypeIdx] : "";
      let fullType = (source + " " + subType).trim();
      if (!fullType) fullType = "Unknown";
      
      let pGroup = "OTHER";
      const tUpper = fullType.toUpperCase();
      if (tUpper.includes("CARD") || tUpper.includes("CONTACTLESS") || tUpper.includes("CHIP") || tUpper.includes("ONLINE") || tUpper.includes("APPLE") || tUpper.includes("GOOGLE") || tUpper.includes("ATM") || tUpper.includes("POS")) {
        pGroup = "CARD";
      } else if (tUpper.includes("DIRECT DEBIT") || tUpper.includes("DD")) {
        pGroup = "DIRECT_DEBIT";
      } else if (tUpper.includes("FASTER PAYMENT") || tUpper.includes("FPS")) {
        pGroup = "FASTER_PAYMENT";
      }

      let statusStr = statusIdx !== -1 && data[i][statusIdx] ? data[i][statusIdx].trim() : "Settled";
      // Normalize capitalization (e.g. "SETTLED" -> "Settled")
      statusStr = statusStr.charAt(0).toUpperCase() + statusStr.slice(1).toLowerCase();

      transactions.push({
        id: 'tx_' + i,
        dateTime: data[i][timeIdx] || "",
        counterparty: cpIdx !== -1 && data[i][cpIdx] ? data[i][cpIdx].trim() : "Unknown",
        reference: refIdx !== -1 && data[i][refIdx] ? data[i][refIdx].trim() : "None",
        transactionType: fullType, 
        amount: Math.abs(rawAmt).toFixed(2), 
        currency: "GBP", 
        status: statusStr,
        direction: "DEBIT",
        paymentGroup: pGroup,
        rawTimeMs: new Date(data[i][timeIdx]).getTime() || 0
      });
    }

    return { success: true, data: transactions };
  } catch (e) {
    return { success: false, error: "Parsing error: " + e.toString() };
  }
}

