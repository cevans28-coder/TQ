/**
 * Extracts transaction variables from a raw text paste.
 * Called by the frontend via google.script.run in View_Paste
 */
function parseTransactionText(rawText) {
  if (!rawText) return { success: false, error: "No text provided." };
  
  try {
    const result = { success: true, data: {} };
    
    // RegEx Patterns targeting the exact statement format
    const dateMatch = rawText.match(/Date & Time:\s*(.+)/i);
    const counterpartyMatch = rawText.match(/Counterparty:\s*(.+)/i);
    const referenceMatch = rawText.match(/Reference:\s*(.+)/i);
    const typeMatch = rawText.match(/Transaction Type:\s*(.+)/i);
    
    // Matches standard currency format e.g., "GBP 15.99 (Debit)"
    const amountMatch = rawText.match(/([A-Z]{3})\s*([\d,]+\.\d{2})\s*\((Credit|Debit)\)/i);
    const statusMatch = rawText.match(/Status:\s*(.+)/i);
    
    // Extracted Values
    result.data.dateTime = dateMatch ? dateMatch[1].trim() : "Unknown";
    result.data.counterparty = counterpartyMatch ? counterpartyMatch[1].trim() : "Unknown";
    result.data.reference = referenceMatch ? referenceMatch[1].trim() : "Unknown";
    result.data.transactionType = typeMatch ? typeMatch[1].trim() : "Unknown";
    result.data.status = statusMatch ? statusMatch[1].trim() : "Unknown";
    
    if (amountMatch) {
      result.data.currency = amountMatch[1];
      result.data.amount = amountMatch[2];
      result.data.direction = amountMatch[3].toUpperCase(); // CREDIT or DEBIT
    } else {
      result.data.currency = "Unknown";
      result.data.amount = "Unknown";
      result.data.direction = "Unknown";
    }

    // MVP Routing Logic: Categorize the payment type
    const typeUpper = result.data.transactionType.toUpperCase();
    
    if (typeUpper.includes("CARD") || 
        typeUpper.includes("CONTACTLESS") || 
        typeUpper.includes("CHIP_AND_PIN") || 
        typeUpper.includes("ATM") || 
        typeUpper.includes("ONLINE")) {
      result.data.paymentGroup = "CARD";
    } else if (typeUpper.includes("DIRECT DEBIT")) {
      result.data.paymentGroup = "DIRECT_DEBIT";
    } else if (typeUpper.includes("FASTER PAYMENT")) {
      result.data.paymentGroup = "FASTER_PAYMENT";
    } else {
      result.data.paymentGroup = "OTHER";
    }

    return result;

  } catch (e) {
    return { 
      success: false, 
      error: "Could not read the transaction data. Please ensure you copied the entire block, including 'Date & Time' and 'Status'." 
    };
  }
}

