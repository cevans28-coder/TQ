    // --- MOBILE SDK FORENSICS (Base64 Decoding) ---
    let sdkAppBundle = "N/A", sdkHardware = "N/A", sdkOS = "N/A", sdkLocalIP = "N/A";
    if (data.deviceInfo) {
      try {
        let decodedDeviceString = Utilities.newBlob(Utilities.base64Decode(data.deviceInfo)).getDataAsString();
