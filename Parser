    // --- DYNAMIC RISK EXTRACTOR ---
    let riskDecision = "N/A", riskScore = "N/A";
    if (data.messageExtension && Array.isArray(data.messageExtension)) {
      for (let i = 0; i < data.messageExtension.length; i++) {
        let ext = data.messageExtension[i];
