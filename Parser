    }

    // --- RETURN DATA ---
    return {
      success: true,
      ip: browserIP,
      location: location,
      name: data.cardholderName || "N/A",
      purchaseDevice: data.browserUserAgent || "N/A",
      purchaseChannel: deviceChannelMap[data.deviceChannel] || "Unknown",
      authResult: compIndMap[data.threeDSCompInd] || "Unknown",
      sdkHardware: sdkHardware,
      sdkOS: sdkOS,
      billingAddress: billingAddress,
      email: customerEmail,
      phone: customerPhone
    };

  } catch (e) {
    return { success: false, error: "Invalid format. Please ensure you copied the payload correctly." };
  }
}
