          sdkOS = sdkData.DD.C003 || sdkData.DD.C001 || "N/A";
          sdkLocalIP = sdkData.DD.C010 || "N/A";
        }
      } catch(e) {
        sdkAppBundle = "Error decoding payload";
      }
    }

    // --- RETURN DATA ---
    return {
