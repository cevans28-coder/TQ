<div id="view-step3" class="view-section">
  <h2 style="margin-bottom: 8px;">Step 3: Verification Check</h2>
  <p style="color: var(--starling-text-light); margin-bottom: 24px;">Extract the data from the Stepups tab to verify the order details against the customer's profile.</p>

  <div id="acs-drop-zone">
    <textarea id="acs-json-input" style="width: 100%; height: 120px; padding: 12px; border: 1px solid var(--starling-border); border-radius: 8px; font-family: monospace; font-size: 13px; margin-bottom: 12px;" placeholder="Paste data here..."></textarea>
    <button id="btn-process-acs" class="btn-secondary" style="width: 100%; margin-bottom: 24px;" onclick="handleAcsPaste()">Verify Details</button>
    <div id="acs-error" style="display: none; color: var(--starling-error-text); font-size: 14px; margin-bottom: 16px;"></div>
  </div>

  <!-- Friction Check (Hidden until parsed) -->
  <div id="friction-zone" style="display: none; animation: fadeIn 0.4s ease;">
    <div style="background: var(--starling-warning-bg); border-left: 4px solid var(--starling-warning-text); padding: 16px; border-radius: 0 8px 8px 0; margin-bottom: 24px;">
      <h4 style="color: var(--starling-warning-text); margin: 0 0 8px 0; font-size: 15px;">⚠️ Fraud Prevention Check</h4>
      <p style="font-size: 14px; margin: 0;">Do these order details match the customer's profile in MP?</p>
      
      <div style="font-family: monospace; background: #fff; padding: 16px; border-radius: 8px; margin-top: 12px; font-size: 13px; border: 1px solid var(--starling-border); line-height: 1.6;">
        Name: <strong id="acs-name" style="color: var(--starling-navy);"></strong><br>
        Email: <strong id="acs-email" style="color: var(--starling-navy);"></strong><br>
        Phone: <strong id="acs-phone" style="color: var(--starling-navy);"></strong><br>
        Address: <strong id="acs-address" style="color: var(--starling-navy);"></strong>
        
        <hr style="border: none; border-top: 1px dashed var(--starling-border); margin: 12px 0;">
        
        Device: <strong id="acs-device" style="color: var(--starling-text-light);"></strong><br>
        IP Location: <strong id="acs-ip" style="color: var(--starling-text-light);"></strong>
      </div>
    </div>

    <h3 style="font-size: 16px; color: var(--starling-navy); margin-bottom: 12px;">Outcome (Based on match):</h3>
    <div style="display: flex; gap: 12px; flex-direction: column;">
      
      <button class="btn-secondary" style="text-align: left; padding: 16px;" onclick="appState.flags.outcome = 'retail'; navigateToView('view-outcomes')">
        <strong>✅ Match: Exact</strong><br>
        <span style="font-size: 13px; font-weight: 400; color: var(--starling-text-light);">Inform customer it wouldn't be considered fraud. Route to Retail Dispute.</span>
      </button>
      
      <button class="btn-secondary" style="text-align: left; padding: 16px;" onclick="appState.flags.outcome = 'civil'; navigateToView('view-outcomes')">
        <strong>🏠 Match: Surname Only</strong><br>
        <span style="font-size: 13px; font-weight: 400; color: var(--starling-text-light);">Possible family member. Route to Civil Dispute.</span>
      </button>
      
      <button class="btn-secondary" style="text-align: left; padding: 16px; border-color: var(--starling-error-text); color: var(--starling-error-text); background: var(--starling-error-bg);" onclick="appState.flags.outcome = 'fraud'; navigateToView('view-outcomes')">
        <strong>❌ Match: None</strong><br>
        <span style="font-size: 13px; font-weight: 400; color: var(--starling-error-text);">Device likely compromised. Raise Card Fraud.</span>
      </button>
      
    </div>
  </div>
</div>
