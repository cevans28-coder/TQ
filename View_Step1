<div id="view-step1" class="view-section">
  <h2 style="margin-bottom: 8px;">Step 1: Memory Jogging & Triage</h2>
  <p style="color: var(--starling-text-light); margin-bottom: 24px;">Check for obvious triggers, related payments, or coercion before proceeding.</p>
  
  <!-- Dynamic Context Box -->
  <div style="background: var(--starling-bg); border-left: 4px solid var(--starling-primary); padding: 16px; border-radius: 0 8px 8px 0; margin-bottom: 24px;">
    <strong style="font-size: 14px; color: var(--starling-text-light); display: block; margin-bottom: 4px;">Target Transaction(s):</strong>
    <span style="font-size: 18px; color: var(--starling-navy); font-weight: 600;" id="step1-amount"></span> to <strong id="step1-merchant"></strong><br>
    <span style="font-size: 14px; color: var(--starling-text);">Reference: <code id="step1-reference" style="background: #e2e6eb; padding: 2px 6px; border-radius: 4px;"></code></span>
    
    <!-- Smart History Badge -->
    <div id="smart-history-badge" onclick="openHistoryModal()" style="display: none; margin-top: 12px; padding: 10px 14px; background: var(--starling-warning-bg); border: 1px solid var(--starling-warning-text); border-radius: 8px; color: var(--starling-warning-text); font-size: 13px; font-weight: 600; align-items: center; gap: 8px; cursor: pointer;">
      <span style="font-size: 16px;">💡</span> 
      <span id="smart-history-text" style="flex: 1;"></span>
      <span>👁️ View</span>
    </div>

    <!-- No History Found Prompt -->
    <div id="no-history-prompt" style="display: none; margin-top: 16px; padding-top: 16px; border-top: 1px solid var(--starling-border);">
      <p style="font-size: 14px; color: var(--starling-text); margin: 0 0 12px 0;"><strong>No automated matches found.</strong> Please check the Cards section of MP to see if there are any linked transactions to this payment under a different name.</p>
      <button class="btn-secondary" style="padding: 8px 16px; font-size: 13px;" onclick="openManualSearchModal()">🔍 Manual Statement Search</button>
    </div>
  </div>

  <!-- Probing Scripts -->
  <div style="margin-bottom: 32px;">
    <h3 style="font-size: 16px; color: var(--starling-navy); margin-bottom: 12px;">Suggested Questions:</h3>
    <div id="dynamic-question-1" style="background: #fff; border: 1px solid var(--starling-border); padding: 16px; font-size: 15px; color: var(--starling-text); font-style: italic; border-radius: 8px; margin-bottom: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.04);"></div>
    <div style="background: #fff; border: 1px solid var(--starling-border); padding: 16px; font-size: 15px; color: var(--starling-text); font-style: italic; border-radius: 8px; margin-bottom: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.04);">
      "Could a friend or family member have made this payment using your card details?"
    </div>
  </div>

  <hr style="border: none; border-top: 1px solid var(--starling-border); margin: 32px 0;">

  <!-- Resolution Routing -->
  <h3 style="font-size: 18px; color: var(--starling-navy); margin-bottom: 16px;">What is the outcome?</h3>
  <div style="display: flex; flex-direction: column; gap: 12px;">
    <button class="btn-secondary" style="text-align: left; padding: 16px; font-size: 15px;" onclick="appState.flags.outcome = 'retail'; navigateToView('view-outcomes')">
      <strong>✅ Payment Recognised</strong><br>
      <span style="font-size: 13px; color: var(--starling-text-light); font-weight: 400;">Customer confirms they made it. Link to Retail Disputes.</span>
    </button>
    <button class="btn-primary" style="text-align: left; padding: 16px; font-size: 15px; display: flex; justify-content: space-between; align-items: center;" onclick="navigateToView('view-step2')">
      <span>
        <strong>❌ Payment STILL unrecognised</strong><br>
        <span style="font-size: 13px; font-weight: 400; opacity: 0.9;">Proceed to Authorisation & 3DS Check.</span>
      </span>
      <span>→</span>
    </button>
  </div>
</div>

<!-- History Modal -->
<div id="history-modal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; justify-content: center; align-items: center;">
  <div style="background: #fff; width: 90%; max-width: 600px; border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.2); overflow: hidden; display: flex; flex-direction: column;">
    <div style="padding: 16px 20px; border-bottom: 1px solid var(--starling-border); display: flex; justify-content: space-between; align-items: center; background: var(--starling-bg);">
      <h3 style="margin: 0; color: var(--starling-navy); font-size: 16px;">Previous Merchant Usage</h3>
      <button onclick="closeHistoryModal()" style="background: none; border: none; font-size: 20px; cursor: pointer; color: var(--starling-text-light);">×</button>
    </div>
    <div style="padding: 0; overflow-y: auto; max-height: 400px; font-size: 14px;">
      <table style="width: 100%; border-collapse: collapse; text-align: left;">
        <thead style="background: var(--starling-sand); position: sticky; top: 0;">
          <tr>
            <th style="padding: 10px 16px; border-bottom: 1px solid var(--starling-border);">Date</th>
            <th style="padding: 10px 16px; border-bottom: 1px solid var(--starling-border);">Amount</th>
            <th style="padding: 10px 16px; border-bottom: 1px solid var(--starling-border);">Type</th>
            <th style="padding: 10px 16px; border-bottom: 1px solid var(--starling-border);">Status</th>
          </tr>
        </thead>
        <tbody id="history-table-body">
          <!-- Populated dynamically -->
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Manual Search Modal -->
<div id="manual-search-modal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; justify-content: center; align-items: center;">
  <div style="background: #fff; width: 90%; max-width: 600px; border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.2); overflow: hidden; display: flex; flex-direction: column;">
    <div style="padding: 16px 20px; border-bottom: 1px solid var(--starling-border); display: flex; justify-content: space-between; align-items: center; background: var(--starling-bg);">
      <h3 style="margin: 0; color: var(--starling-navy); font-size: 16px;">Manual Statement Search</h3>
      <button onclick="closeManualSearchModal()" style="background: none; border: none; font-size: 20px; cursor: pointer; color: var(--starling-text-light);">×</button>
    </div>
    <div style="padding: 16px;">
      <input type="text" id="manual-search-input" placeholder="Search by merchant name or reference..." style="width: 100%; padding: 12px; border: 1px solid var(--starling-border); border-radius: 8px; font-size: 14px; box-sizing: border-box;" onkeyup="filterManualSearch()">
    </div>
    <div style="padding: 0; overflow-y: auto; max-height: 350px; font-size: 14px;">
      <table style="width: 100%; border-collapse: collapse; text-align: left;">
        <thead style="background: var(--starling-sand); position: sticky; top: 0;">
          <tr>
            <th style="padding: 10px 16px; border-bottom: 1px solid var(--starling-border);">Date</th>
            <th style="padding: 10px 16px; border-bottom: 1px solid var(--starling-border);">Merchant</th>
            <th style="padding: 10px 16px; border-bottom: 1px solid var(--starling-border);">Amount</th>
            <th style="padding: 10px 16px; border-bottom: 1px solid var(--starling-border);">Status</th>
          </tr>
        </thead>
        <tbody id="manual-search-table-body">
          <!-- Populated by JS -->
        </tbody>
      </table>
    </div>
  </div>
</div>

