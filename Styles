<style>
  :root {
    /* Starling Brand Colour Palette */
    --starling-primary: #6935D3; 
    --starling-primary-hover: #5529A8;
    --starling-primary-light: rgba(105, 53, 211, 0.1);
    --starling-teal: #19D3C5;
    --starling-teal-hover: #15b3a6;
    --starling-navy: #192851; 
    --starling-bg: #f4f6f8;
    --starling-sand: #F6EFEA;
    --starling-text: #2a3045;
    --starling-text-light: #646a7c;
    --starling-border: #e2e6eb;
    
    /* System Colours */
    --starling-success-bg: #e3f6ed;
    --starling-success-text: #007a4a;
    --starling-error-bg: #fde8e8;
    --starling-error-text: #c81e1e;
    --starling-warning-bg: #fff3e0;
    --starling-warning-text: #e65100;
  }

  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    background-color: var(--starling-bg);
    color: var(--starling-text);
    margin: 0;
    padding: 0;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }

  /* --- GLOBAL LAYOUT --- */
  .app-header {
    background: #fff;
    padding: 16px 24px;
    border-bottom: 1px solid var(--starling-border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .app-header h1 {
    margin: 0;
    font-size: 20px;
    color: var(--starling-navy);
    font-weight: 700;
    letter-spacing: -0.5px;
  }

  .nav-controls {
    display: flex;
    gap: 12px;
    align-items: center;
  }

  .container {
    max-width: 900px;
    margin: 40px auto;
    background: #fff;
    padding: 40px;
    border-radius: 20px;
    box-shadow: 0 8px 30px rgba(25, 40, 81, 0.06);
  }

  /* --- SPA VIEW MANAGEMENT --- */
  .view-section {
    display: none;
    animation: fadeIn 0.3s ease;
  }
  .view-section.active {
    display: block;
  }
  @keyframes fadeIn { 
    from { opacity: 0; transform: translateY(5px); } 
    to { opacity: 1; transform: translateY(0); } 
  }

  /* --- BUTTONS & CONTROLS --- */
  button {
    font-family: inherit;
    transition: all 0.2s ease;
  }

  .btn-primary {
    background-color: var(--starling-primary);
    color: #fff;
    border: none;
    padding: 12px 24px;
    font-size: 16px;
    border-radius: 30px;
    cursor: pointer;
    font-weight: 600;
  }
  .btn-primary:hover { background-color: var(--starling-primary-hover); }
  
  .btn-secondary {
    background-color: #fff;
    color: var(--starling-navy);
    border: 1px solid var(--starling-border);
    padding: 8px 16px;
    font-size: 14px;
    border-radius: 20px;
    cursor: pointer;
    font-weight: 600;
  }
  .btn-secondary:hover { background-color: var(--starling-sand); }
  
  select.nav-select {
    padding: 8px 12px;
    border-radius: 8px;
    border: 1px solid var(--starling-border);
    background: var(--starling-bg);
    color: var(--starling-navy);
    font-weight: 600;
    cursor: pointer;
  }
</style>
