      document.getElementById('cp-dynamic-title').innerText = "MagStripe Diagnostics";
      document.getElementById('flow-magstripe').style.display = 'block';
      
      // Auto-lookup MCC
      const mcc = appState.parsedData.mcc || "";
      let mccString = "Unknown Category";
      if (mcc && MCC_DATABASE[mcc]) mccString = MCC_DATABASE[mcc] + ` (MCC: ${mcc})`;
      document.getElementById('magstripe-mcc-output').innerText = mccString;
    } 
    else if (type === 'mke') {
      document.getElementById('cp-dynamic-title').innerText = "Manual Key Entry (MKE) Diagnostics";
      document.getElementById('flow-mke').style.display = 'block';
      
      // Auto History Display
      if (appState.flags.merchantHistoryCount && appState.flags.merchantHistoryCount > 0) {
        document.getElementById('mke-auto-history-result').innerText = appState.flags.historyString;
        document.getElementById('mke-auto-history-result').style.color = "var(--starling-warning-text)";
      } else {
        document.getElementById('mke-auto-history-result').innerText = "No settled payments found in the provided 18-month CSV.";
        document.getElementById('mke-auto-history-result').style.color = "var(--starling-text)";
      }
    }
  }

  function cpHandleLost(flowType, isLost) {
    if (!isLost) {
      document.getElementById('cp-shared-given-card').style.display = 'block';
      if(flowType === 'chip_pin') document.getElementById('cp-pin-pushback').style.display = 'none';
      if(flowType === 'magstripe') document.getElementById('magstripe-controls-check').style.display = 'none';
    } else {
      document.getElementById('cp-shared-given-card').style.display = 'none';
      document.getElementById('cp-shared-coerced').style.display = 'none';
      
      if(flowType === 'chip_pin') document.getElementById('cp-pin-pushback').style.display = 'block';
      if(flowType === 'magstripe') document.getElementById('magstripe-controls-check').style.display = 'block';
    }
  }

  function cpTriggerSubsCheck() {
    document.getElementById('cp-shared-subs-check').style.display = 'block';
    document.getElementById('cp-pivot-end').style.display = 'none';
    
    // Execute Automated Check (Reusing Contactless logic)
    const primaryTx = appState.parsedData;
    const allTxs = appState.statementData;
    const isCP = (t) => {
      const u = (t || "").toUpperCase();
      return u.includes("CHIP") || u.includes("CONTACTLESS") || u.includes("ATM") || u.includes("POS") || u.includes("MAGSTRIPE");
    };

    const subs = allTxs.filter(tx => tx.rawTimeMs > primaryTx.rawTimeMs && tx.id !== primaryTx.id && isCP(tx.transactionType)).sort((a,b) => a.rawTimeMs - b.rawTimeMs);

    if (subs.length === 0) {
      document.getElementById('cp-shared-no-subs').style.display = 'block';
      document.getElementById('cp-shared-has-subs').style.display = 'none';
    } else {
      document.getElementById('cp-shared-no-subs').style.display = 'none';
      document.getElementById('cp-shared-has-subs').style.display = 'block';
      const tbody = document.getElementById('cp-shared-subs-tbody');
      tbody.innerHTML = '';
      subs.slice(0, 3).forEach(tx => {
         tbody.innerHTML += `<tr>
            <td style="padding: 8px; border-bottom: 1px solid var(--starling-border);">${formatPrettyDate(tx.dateTime).split(',')[0]}</td>
            <td style="padding: 8px; border-bottom: 1px solid var(--starling-border);">${tx.counterparty}</td>
            <td style="padding: 8px; border-bottom: 1px solid var(--starling-border);">£${tx.amount}</td>
         </tr>`;
      });
    }
  }

  function cpPivotToIdentification() {
    // Hide processing branches
    document.getElementById('cp-shared-given-card').style.display = 'none';
    document.getElementById('cp-shared-coerced').style.display = 'none';
    document.getElementById('cp-shared-subs-check').style.display = 'none';
    
    // Show terminal identification block
    document.getElementById('cp-pivot-end').style.display = 'block';

    // Populate the History Badge dynamically
    const historyBadge = document.getElementById('cp-history-badge');
    const historyText = document.getElementById('cp-history-text');
    
    if (appState.flags.historyString) {
      if (historyText) historyText.innerText = appState.flags.historyString;
      if (historyBadge) historyBadge.style.display = 'flex';
    } else {
      if (historyBadge) historyBadge.style.display = 'none';
    }
  }
</script>
