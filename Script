  function handleAcsPaste() {
    const jsonStr = document.getElementById('acs-json-input').value;
    const btn = document.getElementById('btn-process-acs');
    const err = document.getElementById('acs-error');
    
    if(!jsonStr) { err.innerText = "Please paste the data first."; err.style.display = 'block'; return; }
    
    btn.innerText = "Processing...";
    btn.disabled = true;
    err.style.display = 'none';

    google.script.run
      .withSuccessHandler(function(res) {
        btn.innerText = "Verify Details";
        btn.disabled = false;
        
        if(!res.success) {
          err.innerText = res.error;
          err.style.display = 'block';
          return;
        }
        
        appState.acsData = res;
        
        document.getElementById('acs-name').innerText = res.name || "N/A";
        document.getElementById('acs-email').innerText = res.email || "N/A";
        document.getElementById('acs-phone').innerText = res.phone || "N/A";
        document.getElementById('acs-address').innerText = res.billingAddress || "N/A";
        
        // Smart Device string formatting
        let deviceStr = res.purchaseDevice || "N/A";
        if (res.sdkHardware && res.sdkHardware !== "N/A") {
          deviceStr = `${res.sdkHardware} (App: ${res.sdkOS})`;
        } else if (deviceStr.length > 50) {
          // Truncate long User-Agents so they don't break the UI box
          deviceStr = deviceStr.substring(0, 50) + "...";
        }
        document.getElementById('acs-device').innerText = deviceStr;
        document.getElementById('acs-ip').innerText = `${res.ip || 'N/A'} (${res.location || 'Unknown'})`;
        
        document.getElementById('friction-zone').style.display = 'block';
      })
      .processTransactionData(jsonStr);
  }

