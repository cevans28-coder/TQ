  function searchMcc() {
    const query = document.getElementById('mcc-search').value.toLowerCase().trim();
    const commonView = document.getElementById('mcc-common-view');
    const searchView = document.getElementById('mcc-search-results');
    const resultsList = document.getElementById('mcc-results-list');
    const noResults = document.getElementById('mcc-no-results');
    
    if (query.length === 0) {
      commonView.style.display = 'block';
      searchView.style.display = 'none';
      return;
    }
    
    commonView.style.display = 'none';
    searchView.style.display = 'block';
    resultsList.innerHTML = '';
    noResults.style.display = 'none';
    
    let matches = 0;
    for (const [code, description] of Object.entries(MCC_DATABASE)) {
      if (code.includes(query) || description.toLowerCase().includes(query)) {
        matches++;
        const li = document.createElement('li');
        li.style.padding = '12px';
        li.style.marginBottom = '8px';
        li.style.background = '#fafbfc';
        li.style.border = '1px solid var(--starling-border)';
        li.style.borderRadius = '8px';
        li.innerHTML = `<strong style="color: var(--starling-navy);">${code}</strong>: ${description}`;
        resultsList.appendChild(li);
      }
    }
    
    if (matches === 0) {
      noResults.style.display = 'block';
    }
  }

