<script>
  // ==========================================
  // 1. GLOBAL STATE & BANNER
  // ==========================================
  const appState = {
    rawText: "",
    statementData: [],
    selectedTransactions: [],
    merchantHistory: [],
    parsedData: {}, // Acts as the "primary" transaction for routing
    acsData: null,
    flags: {
      cardPresent: false,
      is3dsVerified: false,
      outcome: null,
      merchantHistoryCount: 0,
      lastUsedDate: ""
    }
  };

  let viewHistory = [];
  let selectedTxIndices = new Set(); // Tracks checkboxes

  // Clean Date Formatter
  function formatPrettyDate(dateStr) {
    if (!dateStr) return "Unknown Date";
    try {
      const d = new Date(dateStr);
      if (isNaN(d.getTime())) return dateStr.split('T')[0]; 
      return d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) + 
             " " + d.toLocaleTimeString('en-GB', { hour: '2-digit', minute:'2-digit' });
    } catch(e) { return dateStr; }
  }

  function updateActiveBanner(viewId) {
    const banner = document.getElementById('active-tx-banner');
    if (viewId === 'view-paste' || !appState.parsedData.amount) {
      if(banner) banner.style.display = 'none';
      return;
    }
    
    const data = appState.parsedData;
    document.getElementById('banner-amount').innerText = `${data.currency} ${data.amount}`;
    document.getElementById('banner-merchant').innerText = data.counterparty;
    document.getElementById('banner-date').innerText = formatPrettyDate(data.dateTime).split(',')[0];
    document.getElementById('banner-type').innerText = data.transactionType;
    
    if(banner) banner.style.display = 'flex';
  }

  // ==========================================
  // 2. ROUTING ENGINE
  // ==========================================
  function navigateToView(viewId, isBackAction = false) {
    const currentView = document.querySelector('.view-section.active');
    const targetView = document.getElementById(viewId);
    
    if (!targetView) return;
    if (currentView && !isBackAction) viewHistory.push(currentView.id);

    if (currentView) currentView.classList.remove('active');
    targetView.classList.add('active');
    
    const backBtn = document.getElementById('btn-back');
    if(backBtn) backBtn.style.display = viewHistory.length > 0 ? 'block' : 'none';
    
    const skipDrop = document.getElementById('skip-dropdown');
    if(skipDrop) skipDrop.value = viewId;
    
    updateActiveBanner(viewId);

    // Fire Init
    if (viewId === 'view-step1') view_step1_init();
    if (viewId === 'view-step2') view_step2_init();
    if (viewId === 'view-holding') view_holding_init();
    if (viewId === 'view-outcomes') view_outcomes_init();
    if (viewId === 'view-pos-check') view_pos_check_init();
    if (viewId === 'view-contactless-check') view_contactless_check_init();
    if (viewId === 'view-other-cp-check') view_other_cp_check_init();
    if (viewId === 'view-drf') view_drf_init();
  }

  function goBack() {
    if (viewHistory.length > 0) navigateToView(viewHistory.pop(), true);
  }

  function handleSkip(selectElement) {
    navigateToView(selectElement.value);
  }

  function resetApp() {
    appState.statementData = [];
    appState.selectedTransactions = [];
    appState.parsedData = {};
    appState.merchantHistory = [];
    selectedTxIndices.clear();
    viewHistory = [];
    
    navigateToView('view-paste');
    document.getElementById('paste-input').value = '';
    document.getElementById('tx-selection-area').style.display = 'none';
  }

  // ==========================================
  // 3. VIEW CONTROLLERS
  // ==========================================

  // --- View Paste: CSV & Multi-Select ---
  function handleCsvPaste() {
    const rawText = document.getElementById('paste-input').value.trim();
    const errorDiv = document.getElementById('paste-error');
    const btn = document.getElementById('btn-parse');
    
    if (!rawText) {
      errorDiv.innerText = "Please paste the CSV data first.";
      errorDiv.style.display = "block";
      return;
    }
    
    errorDiv.style.display = "none";
    btn.innerText = "Loading...";
    btn.disabled = true;
    
    google.script.run
      .withSuccessHandler(function(response) {
        btn.innerText = "Load Transactions";
        btn.disabled = false;
        
        if (!response.success) {
          errorDiv.innerText = response.error;
          errorDiv.style.display = "block";
          return;
        }
        
        appState.statementData = response.data; 
        selectedTxIndices.clear();
        renderTransactionTable(response.data);
      })
      .processStatementCsv(rawText);
  }

function renderTransactionTable(transactions) {
    const tbody = document.getElementById('tx-table-body');
    tbody.innerHTML = '';
    
    if (transactions.length === 0) {
      tbody.innerHTML = '<tr><td colspan="6" style="padding: 16px; text-align: center;">No outbound debits found.</td></tr>';
    } else {
      transactions.forEach((tx, index) => {
        let statusColor = "var(--starling-text-light)";
        let statusBg = "transparent";
        if (tx.status === "Declined" || tx.status === "Reversed") {
           statusColor = "var(--starling-error-text)"; statusBg = "var(--starling-error-bg)";
        } else if (tx.status === "Pending") {
           statusColor = "var(--starling-warning-text)"; statusBg = "var(--starling-warning-bg)";
        }
        
        const tr = document.createElement('tr');
        tr.className = 'tx-row';
        tr.style.borderBottom = '1px solid var(--starling-border)';
        tr.innerHTML = `
          <td style="padding: 12px; text-align: center;">
            <input type="checkbox" onchange="toggleTxSelection(${index}, this.checked)" style="width: 16px; height: 16px; cursor: pointer;">
          </td>
          <td style="padding: 12px;">${formatPrettyDate(tx.dateTime).split(',')[0]}</td>
          <td style="padding: 12px; font-weight: 600; color: var(--starling-navy);">${tx.counterparty}</td>
          <td style="padding: 12px;">${tx.transactionType}</td>
          <td style="padding: 12px;">£${tx.amount}</td>
          <td style="padding: 12px;">
            <span style="background: ${statusBg}; color: ${statusColor}; padding: 4px 8px; border-radius: 4px; font-size: 12px; font-weight: 600;">${tx.status}</span>
          </td>
        `;
        tbody.appendChild(tr);
      });
    }
    
    document.getElementById('tx-selection-area').style.display = 'block';
    updateSelectionFooter();
  }

// ==========================================
  // HIGH-PERFORMANCE SEARCH & FILTER ENGINE
  // ==========================================
  let searchTimeout;
  
  // Ensure the Set exists
  if (typeof selectedTxIndices === 'undefined') {
    window.selectedTxIndices = new Set();
  }

  function debouncedSearch() {
    clearTimeout(searchTimeout);
    searchTimeout = setTimeout(filterTransactions, 250);
  }

  function filterTransactions() {
    const query = document.getElementById('tx-search').value.toLowerCase().trim();
    const settledOnly = document.getElementById('settled-toggle').checked;
    const tbody = document.getElementById('tx-table-body');
    
    let html = '';
    let renderedCount = 0;
    const RENDER_LIMIT = 150; 

    for (let i = 0; i < appState.statementData.length; i++) {
      const tx = appState.statementData[i];
      
      if (settledOnly && tx.status.toLowerCase() !== 'settled') continue;
      
      if (query) {
        const searchString = `${tx.counterparty} ${tx.amount} ${formatPrettyDate(tx.dateTime)}`.toLowerCase();
        if (!searchString.includes(query)) continue;
      }

      const isChecked = selectedTxIndices.has(i) ? 'checked' : '';
      
      // Sandbox-safe fix: Using data-index and passing event instead of 'this'
      html += `
        <tr style="background: ${isChecked ? 'var(--starling-primary-light)' : '#fff'}; transition: background 0.2s;">
          <td style="padding: 12px; border-bottom: 1px solid var(--starling-border); text-align: center;">
            <input type="checkbox" data-index="${i}" onchange="handleCheckboxChange(event)" ${isChecked} style="width: 16px; height: 16px; cursor: pointer;">
          </td>
          <td style="padding: 12px; border-bottom: 1px solid var(--starling-border); color: var(--starling-text-light);">${formatPrettyDate(tx.dateTime).split(',')[0]}</td>
          <td style="padding: 12px; border-bottom: 1px solid var(--starling-border); font-weight: 600; color: var(--starling-navy);">${tx.counterparty}</td>
          <td style="padding: 12px; border-bottom: 1px solid var(--starling-border); color: var(--starling-text-light);">${tx.transactionType}</td>
          <td style="padding: 12px; border-bottom: 1px solid var(--starling-border);">£${tx.amount}</td>
          <td style="padding: 12px; border-bottom: 1px solid var(--starling-border); color: var(--starling-text-light);">${tx.status}</td>
        </tr>`;
        
      renderedCount++;
      if (renderedCount >= RENDER_LIMIT) {
        html += `<tr><td colspan="6" style="text-align: center; padding: 12px; color: var(--starling-text-light); font-style: italic;">Showing top ${RENDER_LIMIT} results. Keep typing to narrow down.</td></tr>`;
        break; 
      }
    }
    
    tbody.innerHTML = html;
  }

// ==========================================
  // INITIAL RENDER SELECTION CATCHER
  // ==========================================
  function toggleSelection(index, checkbox) {
    if (checkbox.checked) {
      selectedTxIndices.add(index);
    } else {
      selectedTxIndices.delete(index);
    }
    
    const count = selectedTxIndices.size;
    const countEl = document.getElementById('selection-count');
    if (countEl) countEl.innerText = `${count} payment(s) selected`;
    
    const proceedBtn = document.getElementById('btn-proceed');
    if (proceedBtn) proceedBtn.disabled = (count === 0);
    
    const row = checkbox.closest('tr');
    if (row) {
      row.style.background = checkbox.checked ? 'var(--starling-primary-light)' : '#fff';
    }
  }

  function handleCheckboxChange(event) {
    const checkbox = event.target;
    // Extract the index we safely hid in the HTML data-index attribute
    const index = parseInt(checkbox.getAttribute('data-index'), 10);
    
    if (checkbox.checked) {
      selectedTxIndices.add(index);
    } else {
      selectedTxIndices.delete(index);
    }
    
    const count = selectedTxIndices.size;
    const countEl = document.getElementById('selection-count');
    countEl.innerText = `${count} payment(s) selected`;
    document.getElementById('btn-proceed').disabled = (count === 0);
    
    const row = checkbox.closest('tr');
    if (row) {
      row.style.background = checkbox.checked ? 'var(--starling-primary-light)' : '#fff';
    }
  }

  // ==========================================
  // SELECTION MODAL MANAGEMENT
  // ==========================================
  function openSelectedModal() {
    if (selectedTxIndices.size === 0) return; // Do nothing if empty
    
    document.getElementById('selected-modal').style.display = 'flex';
    renderSelectedModal();
  }

  function closeSelectedModal() {
    document.getElementById('selected-modal').style.display = 'none';
  }

  function renderSelectedModal() {
    const tbody = document.getElementById('selected-modal-body');
    tbody.innerHTML = '';
    
    selectedTxIndices.forEach(index => {
      const tx = appState.statementData[index];
      tbody.innerHTML += `
        <tr>
          <td style="padding: 12px; border-bottom: 1px solid var(--starling-border); color: var(--starling-text-light);">${formatPrettyDate(tx.dateTime)}</td>
          <td style="padding: 12px; border-bottom: 1px solid var(--starling-border); font-weight: 600; color: var(--starling-navy);">${tx.counterparty}</td>
          <td style="padding: 12px; border-bottom: 1px solid var(--starling-border);">£${tx.amount}</td>
          <td style="padding: 12px; border-bottom: 1px solid var(--starling-border);">
            <button onclick="removeSelectionFromModal(${index})" style="background: none; border: 1px solid var(--starling-error-text); color: var(--starling-error-text); padding: 4px 8px; border-radius: 4px; cursor: pointer; font-size: 12px; font-weight: 600;">Remove</button>
          </td>
        </tr>`;
    });
  }

  function removeSelectionFromModal(index) {
    // Remove from the underlying Set
    selectedTxIndices.delete(index);
    
    // Update the UI text
    const count = selectedTxIndices.size;
    const countEl = document.getElementById('selection-count');
    countEl.innerText = `${count} payment(s) selected`;
    document.getElementById('btn-proceed').disabled = (count === 0);
    
    // Re-render the background table and the modal
    filterTransactions(); 
    
    if (count === 0) {
      closeSelectedModal();
    } else {
      renderSelectedModal();
    }
  }

  // Small CSS tweak on the hover state for the clickable text
  document.getElementById('selection-count').addEventListener('mouseover', function() {
    if(selectedTxIndices.size > 0) this.style.background = 'var(--starling-primary-light)';
  });
  document.getElementById('selection-count').addEventListener('mouseout', function() {
    this.style.background = 'transparent';
  });

  function toggleTxSelection(index, isChecked) {
    if (isChecked) selectedTxIndices.add(index);
    else selectedTxIndices.delete(index);
    updateSelectionFooter();
  }

  function updateSelectionFooter() {
    const count = selectedTxIndices.size;
    
    // Look for either the old or new ID, and only update if it exists
    const summaryEl = document.getElementById('selection-summary') || document.getElementById('selection-count');
    if (summaryEl) {
        summaryEl.innerText = `${count} payment(s) selected`;
    }
    
    // Do the same for the proceed button
    const btnEl = document.getElementById('btn-process-selection') || document.getElementById('btn-proceed');
    if (btnEl) {
        btnEl.disabled = count === 0;
    }
    
    // Check if any selected items are Declined/Reversed to show warning
    let hasInvalidStatus = false;
    selectedTxIndices.forEach(idx => {
       const tx = appState.statementData[idx];
       if (tx.status === "Declined" || tx.status === "Reversed") hasInvalidStatus = true;
    });
    
    const warningEl = document.getElementById('status-warning');
    if (warningEl) {
        warningEl.style.display = hasInvalidStatus ? 'block' : 'none';
    }
}

// --- Auto-Macro Detection Engine ---
  function findAutoMacroIndex(tx, historyCount) {
    const cp = (tx.counterparty || "").toLowerCase();
    const ref = (tx.reference || "").toLowerCase();
    const type = (tx.transactionType || "").toLowerCase();
    const searchString = cp + " " + ref; // Combine to search both fields

    // Helper to safely find index by exact macro name (must match your Data_Macros file)
    const getMacro = (name) => MACRO_DATABASE.findIndex(m => m.merchant === name);

    // 1. Amazon Specific Logic
    if (searchString.includes("amazon") || searchString.includes("amzn")) {
      if (searchString.includes("prime") || type.includes("subscription") || type.includes("recurring") || type.includes("continuous")) {
        return getMacro("Amazon Prime");
      } else if (historyCount > 0) {
        return getMacro("Amazon (General)");
      }
      return -1; 
    }

    // 2. Google Ecosystem (Play, YouTube, Holds)
    if (searchString.includes("google") || searchString.includes("youtube")) {
      if (searchString.includes("youtube")) return getMacro("YouTube Premium");
      if (searchString.includes("hold") || searchString.includes("temporary") || searchString.includes("temp")) return getMacro("Google Temporary Hold");
      return getMacro("Google Play");
    }

    // 3. Apple Ecosystem
    if (searchString.includes("apple.com/bill") || searchString.includes("itunes") || searchString.includes("apple.com")) {
      return getMacro("iTunes/App Store");
    }

    // 4. Microsoft / Gaming
    if (searchString.includes("xbox") || searchString.includes("microsoft") || searchString.includes("msft")) {
      return getMacro("Microsoft Xbox");
    }
    if (searchString.includes("playstation") || searchString.includes("psn") || searchString.includes("sony ent")) {
      return getMacro("PlayStation");
    }

    // 5. Webloyalty & Cashback Subscriptions
    if (searchString.includes("completesave") || searchString.includes("wly*comp")) return getMacro("Completesave/Savings");
    if (searchString.includes("mytimerewards") || searchString.includes("wly*mytime")) return getMacro("My Time Reward");
    if (searchString.includes("nxrewards") || searchString.includes("nx rewards") || searchString.includes("wly*nx")) return getMacro("National Express Rewards");

    // 6. Comprehensive Dictionary Matcher for the remaining list
    const mappings = {
      "bolt": "Bolt",
      "curve": "Curve",
      "crv*": "Curve",
      "dazn": "DAZN",
      "deliveroo": "Deliveroo",
      "edreams": "eDreams Prime/Opodo",
      "opodo": "eDreams Prime/Opodo",
      "experian": "Experian",
      "fabletics": "Fabletics",
      "techstyle": "Fabletics", // Fabletics parent company
      "gocardless": "GoCardless",
      "hatchster": "Hatchster Limited (Lotto Social)",
      "lotto social": "Hatchster Limited (Lotto Social)",
      "hellofresh": "HelloFresh",
      "hello fresh": "HelloFresh",
      "justanswer": "JustAnswer",
      "just eat": "Just Eat",
      "justeat": "Just Eat",
      "klarna": "Klarna",
      "now tv": "Now TV",
      "nowtv": "Now TV",
      "nyx": "NYX",
      "dnata": "Offline Airline payment including Dnata & Newrest Catering",
      "newrest": "Offline Airline payment including Dnata & Newrest Catering",
      "onlyfans": "Only Fans (OF)",
      "only fans": "Only Fans (OF)",
      "fenix": "Only Fans (OF)", // OnlyFans parent company
      "on top up": "On Top Up",
      "ontopup": "On Top Up",
      "surestream": "On Top Up", // On Top Up parent company
      "packlink": "Packlink",
      "paramount": "Paramount Plus",
      "paypal": "Paypal", // Match spelling exactly as it appears in Data_Macros
      "playerlands": "PlayerLands",
      "spotify": "Spotify",
      "stagecoach": "Stagecoach",
      "tfl": "Public Transport/TfL",
      "transport for london": "Public Transport/TfL",
      "vehicleenquiry": "Vehicle Information",
      "air-serv": "NYA*Air-Serv",
      "air serv": "NYA*Air-Serv"
    };

    // Scan the dictionary to see if any of these keywords appear in the transaction string
    for (const [keyword, macroName] of Object.entries(mappings)) {
      if (searchString.includes(keyword)) {
        return getMacro(macroName);
      }
    }

    // No match found
    return -1;
  }

  // --- Proceed & Routing Logic ---
  function submitSelectedTxs() {
    const selectedTxs = Array.from(selectedTxIndices).map(i => appState.statementData[i]);
    selectedTxs.sort((a,b) => b.rawTimeMs - a.rawTimeMs);
    const primaryTx = selectedTxs[0]; 
    
    appState.selectedTransactions = selectedTxs;
    appState.parsedData = { ...primaryTx }; 
    
    if (selectedTxs.length > 1) {
       const totalAmount = selectedTxs.reduce((sum, tx) => sum + parseFloat(tx.amount), 0).toFixed(2);
       appState.parsedData.amount = totalAmount;
       appState.parsedData.reference = "Multiple References";
    }

    // Smart History Check
    const selectedIds = new Set(selectedTxs.map(t => t.id));
    const previousPayments = appState.statementData.filter(tx => 
      tx.counterparty.toLowerCase() === primaryTx.counterparty.toLowerCase() && 
      !selectedIds.has(tx.id) &&
      tx.rawTimeMs <= primaryTx.rawTimeMs
    );
    
    previousPayments.sort((a,b) => b.rawTimeMs - a.rawTimeMs);
    appState.merchantHistory = previousPayments;
    
    // Count by Status
    let settled = 0, declined = 0, reversed = 0, pending = 0;
    let lastSettledDate = "";
    
    previousPayments.forEach(tx => {
       if (tx.status === "Settled") {
          settled++;
          if (!lastSettledDate) lastSettledDate = formatPrettyDate(tx.dateTime).split(',')[0];
       }
       else if (tx.status === "Declined") declined++;
       else if (tx.status === "Reversed") reversed++;
       else if (tx.status === "Pending") pending++;
    });

    appState.flags.merchantHistoryCount = settled; 
    
    // Build the dynamic History string
    if (previousPayments.length > 0) {
      let hStr = "";
      if (settled > 0) hStr = `Customer has ${settled} previous settled payment(s) (Last: ${lastSettledDate}).`;
      else hStr = `No previous settled payments found.`;
      
      let extras = [];
      if (pending > 0) extras.push(`${pending} pending`);
      if (declined > 0) extras.push(`${declined} declined`);
      if (reversed > 0) extras.push(`${reversed} reversed`);
      
      if (extras.length > 0) hStr += ` They also have ${extras.join(', ')}.`;
      hStr += " Ask about this!";
      
      appState.flags.historyString = hStr;
    } else {
      appState.flags.historyString = "";
    }

// Primary Routing
    if (primaryTx.paymentGroup === "CARD") {
      const typeUpper = (primaryTx.transactionType || "").toUpperCase();
      
      const isWallet = typeUpper.includes("APPLE") || typeUpper.includes("GOOGLE") || typeUpper.includes("ANDROID") || typeUpper.includes("WALLET");
      const isContactless = typeUpper.includes("CONTACTLESS");
      const isChipPin = typeUpper.includes("CHIP") || typeUpper.includes("PIN");
      const isMagstripe = typeUpper.includes("MAGSTRIPE");
      const isMke = typeUpper.includes("MANUAL") || typeUpper.includes("KEY") || typeUpper.includes("MKE");
      
      if (isWallet) navigateToView('view-wallet-check');
      else if (isContactless) navigateToView('view-contactless-check');
      else if (isChipPin) { appState.flags.cpType = 'chip_pin'; navigateToView('view-other-cp-check'); }
      else if (isMagstripe) { appState.flags.cpType = 'magstripe'; navigateToView('view-other-cp-check'); }
      else if (isMke) { appState.flags.cpType = 'mke'; navigateToView('view-other-cp-check'); }
      else navigateToView('view-step1'); // Fallback to Online
      
    } else {
      navigateToView('view-holding');
    }
    
    // --- AUTO-TRIGGER MACRO MODAL ---
    const autoMacroIdx = findAutoMacroIndex(primaryTx, settled);
    if (autoMacroIdx !== -1) {
      // Small timeout allows the view to change in the background before popping the modal
      setTimeout(() => {
        openMacroModal();
        selectMacro(autoMacroIdx);
      }, 400); 
    }
  }
// --- View Auth/PoS Check ---
  function view_pos_check_init() {
    const type = appState.parsedData.transactionType || "Unknown";
    document.getElementById('pos-check-type').innerText = type;
    document.getElementById('pos-check-type-inline').innerText = type;
    
    // Only show the "Lost/Stolen" physical card check if it's actually a physical card payment
    const typeUpper = type.toUpperCase();
    const isPoS = typeUpper.includes("CHIP") || typeUpper.includes("CONTACTLESS") || typeUpper.includes("ATM") || typeUpper.includes("MAGSTRIPE") || typeUpper.includes("POS");
    
    const physicalCheck = document.getElementById('physical-card-check');
    if (physicalCheck) {
      physicalCheck.style.display = isPoS ? 'block' : 'none';
    }
  }
 // --- View Step 1: Memory & History ---
  function view_step1_init() {
    const data = appState.parsedData;
    
    document.getElementById('step1-amount').innerText = `${data.currency} ${data.amount}`;
    
    let merchLabel = data.counterparty;
    if (appState.selectedTransactions.length > 1) merchLabel += ` (${appState.selectedTransactions.length} payments)`;
    document.getElementById('step1-merchant').innerText = merchLabel;
    
    document.getElementById('step1-reference').innerText = data.reference;

    // Handle Smart History Badge OR No History Prompt
    const historyBadge = document.getElementById('smart-history-badge');
    const historyText = document.getElementById('smart-history-text');
    const noHistoryPrompt = document.getElementById('no-history-prompt');
    
    if (appState.flags.historyString) {
      historyText.innerText = appState.flags.historyString;
      historyBadge.style.display = 'flex';
      if (noHistoryPrompt) noHistoryPrompt.style.display = 'none';
    } else {
      historyBadge.style.display = 'none';
      if (noHistoryPrompt) noHistoryPrompt.style.display = 'block';
    }

    // --- DYNAMIC QUESTION LOGIC ---
    // Get the most recent payment amount (selectedTransactions is already sorted newest-first)
    let recentAmount = data.amount;
    if (appState.selectedTransactions && appState.selectedTransactions.length > 0) {
       recentAmount = appState.selectedTransactions[0].amount;
    }
    const formattedAmount = `£${recentAmount}`;

    const typeUpper = (data.transactionType || "").toUpperCase();
    let dynamicQ = "";
    
    if (typeUpper.includes("SUBSCRIPTION")) {
      dynamicQ = `"Are you expecting any subscriptions for ${formattedAmount}? Sometimes the trading name looks completely different from the website."`;
    } else if (typeUpper.includes("ATM")) {
      dynamicQ = `"Do you remember withdrawing ${formattedAmount} in cash? Sometimes the cash machine operator's name appears instead of the bank's."`;
    } else if (typeUpper.includes("CONTACTLESS") || typeUpper.includes("CHIP")) {
      dynamicQ = `"Do you remember visiting a shop, restaurant, or pub for ${formattedAmount}? Their official trading name can be different from the sign on the shop."`;
    } else {
      dynamicQ = `"Have you made any online purchases recently for ${formattedAmount}?"`;
    }

    document.getElementById('dynamic-question-1').innerText = dynamicQ;
  }

  function openHistoryModal() {
    const tbody = document.getElementById('history-table-body');
    tbody.innerHTML = '';
    
