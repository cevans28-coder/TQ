  function view_contactless_check_init() {
    // Reset displays
    document.getElementById('cl-card-given-q').style.display = 'none';
    document.getElementById('cl-coerced-q').style.display = 'none';
    document.getElementById('cl-subsequent-check').style.display = 'none';
    document.getElementById('cl-not-fraud-pushback').style.display = 'none';

    // Automation: Scan for subsequent Card Present transactions
    const primaryTx = appState.parsedData;
    const allTxs = appState.statementData;

    const isCP = (type) => {
      const t = (type || "").toUpperCase();
      return t.includes("CHIP") || t.includes("CONTACTLESS") || t.includes("ATM") || t.includes("POS") || t.includes("MAGSTRIPE");
    };

    // Filter for CP txs that occurred strictly AFTER the primaryTx
    const subsequent = allTxs.filter(tx => 
      tx.rawTimeMs > primaryTx.rawTimeMs && 
      tx.id !== primaryTx.id && 
      isCP(tx.transactionType)
    ).sort((a,b) => a.rawTimeMs - b.rawTimeMs);

    appState.flags.subsequentCP = subsequent;
  }

  function handleContactlessLost(isLost) {
    document.getElementById('cl-not-fraud-pushback').style.display = 'none';
    
    if (!isLost) {
      document.getElementById('cl-card-given-q').style.display = 'block';
      document.getElementById('cl-subsequent-check').style.display = 'none';
    } else {
      document.getElementById('cl-card-given-q').style.display = 'none';
      document.getElementById('cl-coerced-q').style.display = 'none';
      
      const subs = appState.flags.subsequentCP || [];
      document.getElementById('cl-subsequent-check').style.display = 'block';

      if (subs.length === 0) {
        document.getElementById('cl-no-subs').style.display = 'block';
        document.getElementById('cl-has-subs').style.display = 'none';
      } else {
        document.getElementById('cl-no-subs').style.display = 'none';
